manifest {
    name        = 'reusability'
    description = 'Reuse of public omics data (GEO/SRA) in biomedical publications'
    mainScript  = 'main.nf'
}

params {
    mode                 = 'collect'                            // collect | reuse_check
    outdir               = "${projectDir}/data"                 // all results end up here
    python               = "${projectDir}/.venv/bin/python"     // interpreter with pandas, lxml, requests, ...
    ftp_server           = 'ftp.ebi.ac.uk'
    ftp_dir              = '/pub/databases/pmc/oa/'
    limit                = 0                                    // >0: process only the first N archives (testing)
    parallel_downloads   = 4                                    // archives downloaded/parsed at the same time
    skip_geo             = false
    skip_sra             = false
    skip_gold            = false
    // reuse_check
    skip_text_check      = false
    text_check_n         = 40                                   // pairs per stratum for the text check
    seed                 = 20261122
    llm_model            = 'Qwen/Qwen3-14B-AWQ'                 // must be in ~/.cache/huggingface (offline)
    llm_image            = 'vllm/vllm-openai:v0.9.0'
}

process {
    executor = 'local'
    errorStrategy = 'retry'
    maxRetries = 3

    // Only this process runs in a container; all others use the project venv on the host.
    withName: 'LLM_CLASSIFY' {
        container        = params.llm_image
        maxForks         = 1
        containerOptions = "--gpus all --entrypoint '' --shm-size=8g " +
                           "-v ${System.getenv('HOME')}/.cache/huggingface:/hf " +
                           "-e HF_HOME=/hf -e HF_HUB_OFFLINE=1 -e HOME=/tmp -e VLLM_NO_USAGE_STATS=1"
    }
}

docker.enabled = true   // used only by processes that set a container

// NCBI_API_KEY (optional) is read from the environment by the SRA step.

report   { enabled = true; overwrite = true; file = "${params.outdir}/nextflow_report.html" }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/nextflow_timeline.html" }
