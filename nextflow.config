manifest {
    name        = 'reusability'
    description = 'Reuse of public omics data (GEO/SRA) in biomedical publications'
    mainScript  = 'main.nf'
}

params {
    mode                 = 'collect'                            // collect | analyze | reuse_check
    outdir               = "${projectDir}/data"                 // all results end up here
    python               = "${projectDir}/.venv/bin/python"     // interpreter with pandas, lxml, requests, ...
    ftp_server           = 'ftp.ebi.ac.uk'
    ftp_dir              = '/pub/databases/pmc/oa/'
    limit                = 0                                    // >0: process only the first N archives (testing)
    parallel_downloads   = 4                                    // archives downloaded/parsed at the same time
    skip_geo             = false
    skip_sra             = false
    skip_gold            = false
    skip_analyze         = false                                // collect without notebooks + report
    sra_attempts         = 3                                    // SRA recheck: accept remaining failures on this attempt
    kernel               = 'reusability-venv'                   // Jupyter kernel of .venv (see README)
    // reuse_check
    skip_text_check      = false
    text_check_scope     = 'sample'                             // sample | all
    text_check_n         = 40                                   // sample: pairs per stratum
    text_check_chunk     = 20000                                // all: pairs per chunk (one model load each)
    seed                 = 20261122
    llm_model            = 'Qwen/Qwen3-14B-AWQ'                 // downloaded into ~/.cache/huggingface on first use
    llm_revision         = '31c69efc29464b6bb0aee1398b5a7b50a99340c3'
    llm_image            = 'vllm/vllm-openai:v0.9.0'
}

process {
    executor = 'local'
    errorStrategy = 'retry'
    maxRetries = 3

    // Retries are set here: the config overrides directives written in main.nf.
    withName: 'PMC_TO_PMID'        { maxRetries = 5 }
    withName: 'FETCH_CONTEXT'      { maxForks = 1 }                  // NCBI rate limit
    withName: 'NOTEBOOKS|REPORT'   { errorStrategy = 'terminate' }   // deterministic, a retry only repeats the error

    // Only this process runs in a container; all others use the project venv on the host.
    withName: 'LLM_CLASSIFY' {
        container        = params.llm_image
        maxForks         = 1
        maxRetries       = 1
        containerOptions = "--gpus all --entrypoint '' --shm-size=8g " +
                           "-v ${System.getenv('HOME')}/.cache/huggingface:/hf " +
                           "-e HF_HOME=/hf -e HOME=/tmp -e USER=reusability -e LOGNAME=reusability -e VLLM_NO_USAGE_STATS=1"
    }
}

docker.enabled    = true                      // used only by processes that set a container
docker.runOptions = '-u $(id -u):$(id -g)'    // outputs owned by the user, not root

// NCBI_API_KEY (optional) is read from the environment by the SRA step.

report   { enabled = true; overwrite = true; file = "${params.outdir}/nextflow_report.html" }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/nextflow_timeline.html" }
